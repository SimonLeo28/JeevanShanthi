Options +FollowSymLinks
RewriteEngine On

# Force canonical domain and HTTPS
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.jeevanshanthi.com%{REQUEST_URI} [R=301,L]

# Remove index.html and canonicalize .html pages to clean URLs
RewriteCond %{THE_REQUEST} \s/+index\.html [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(.+?)\.html [NC]
RewriteRule ^ /%1/ [R=301,L]

# Route clean URLs to the real files
RewriteRule ^about/?$ /about.html [L,NC]
RewriteRule ^services/?$ /services.html [L,NC]
RewriteRule ^contact/?$ /contact.html [L,NC]
